{
    "$schema": "https://json-schema.org/draft/2020-12/schema#",
    "description": "ServiceNow SDK configuration schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Schema file to validate this configuration file"
        },
        "scope": {
            "type": "string",
            "description": "Scope of the application (example: 'x_myapp' or 'sn_myapp'). Truncated by instance after 18 characters"
        },
        "name": {
            "type": "string",
            "maxLength": 100,
            "description": "Name of the application (example: 'MyApp')"
        },
        "scopeId": {
            "type": "string",
            "minLength": 0,
            "maxLength": 32,
            "pattern": "^([0-9a-zA-Z]{32}|global$)",
            "description": "Scope ID of the application (example: 'fc1b5713c3db3110d6489a038a40dd85')"
        },
        "entitiesDir": {
            "type": "string",
            "minLength": 1,
            "deprecated": true,
            "description": "DEPRECATED: Use 'fluentDir' instead"
        },
        "fluentDir": {
            "type": "string",
            "minLength": 1,
            "description": "Directory containing .now.ts fluent files of the application",
            "default": "src/fluent"
        },
        "clientDir": {
            "type": "string",
            "description": "Directory containing client files of the application, such as HTML and TypeScript files. Set to empty to disable the client build.",
            "default": "src/client"
        },
        "generatedDir": {
            "type": "string",
            "minLength": 1,
            "description": "Directory relative to 'fluentDir' where Fluent will generate files, such as keys.ts",
            "default": "generated"
        },
        "staticContent": {
            "type": "object",
            "additionalProperties": false,
            "description": "Static asset build configuration.",
            "properties": {
                "buildDir": {
                    "type": "string",
                    "minLength": 1,
                    "default": "dist/static",
                    "description": "Directory where the client build emits static assets that the SDK scans and packages"
                },
                "paths": {
                    "type": "object",
                    "description": "Mapping of source files to static output paths.",
                    "patternProperties": {
                        ".*": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "assets": {
                    "type": "object",
                    "description": "Mapping of glob patterns to static content configuration. Each key is a glob pattern relative to the project root and each value specifies how matched files are published.",
                    "patternProperties": {
                        ".*": {
                            "type": "object",
                            "required": [
                                "publicPath"
                            ],
                            "additionalProperties": false,
                            "properties": {
                                "publicPath": {
                                    "type": "string",
                                    "description": "The public URL path prefix for matched static content files"
                                }
                            }
                        }
                    }
                }
            }
        },
        "staticContentDir": {
            "type": "string",
            "minLength": 1,
            "deprecated": true,
            "description": "DEPRECATED: Use 'staticContent.buildDir' instead"
        },
        "staticContentPaths": {
            "type": "object",
            "deprecated": true,
            "description": "DEPRECATED: Use 'staticContent.paths' instead",
            "patternProperties": {
                ".*": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "npmUpdateCheck": {
            "type": [
                "number",
                "boolean"
            ],
            "default": 10
        },
        "serverModulesDir": {
            "type": "string",
            "description": "Directory containing modular files to be built into sys_modules",
            "default": "src/server"
        },
        "serverModulesIncludePatterns": {
            "type": "array",
            "description": "Patterns to include when building server modules",
            "items": {
                "type": "string"
            },
            "default": [
                "**/*.ts",
                "**/*.tsx",
                "**/*.js",
                "**/*.jsx",
                "**/*.cts",
                "**/*.cjs",
                "**/*.mts",
                "**/*.mjs",
                "**/*.json"
            ]
        },
        "serverModulesExcludePatterns": {
            "type": "array",
            "description": "Patterns to exclude when building server modules",
            "items": {
                "type": "string"
            },
            "default": [
                "**/*.test.ts",
                "**/*.test.js",
                "**/*.d.ts"
            ]
        },
        "modulePaths": {
            "type": "object",
            "description": "Mapping between file glob patterns to resolve imported file paths to valid runtime paths. This is needed if your Fluent files are importing modules from a different location than the runtime modules. For example, if you have a custom TypeScript setup that transpiles modules from a 'src' directory to a 'dist' directory, you would need to specify that mapping here.",
            "patternProperties": {
                ".*": {
                    "type": "string"
                }
            }
        },
        "tsconfigPath": {
            "type": "string",
            "description": "Path to tsconfig file to be used for transpilation of server module typescript. ServiceNow SDK will emit build errors following the referenced tsconfig. (example: './src/server/tsconfig.json')"
        },
        "transpiledSourceDir": {
            "type": "string",
            "deprecated": true,
            "description": "DEPRECATED: Use 'modulePaths' instead"
        },
        "metadataDir": {
            "type": "string",
            "description": "Directory containing metadata xml for the app",
            "default": "metadata"
        },
        "appOutputDir": {
            "type": "string",
            "description": "Location to output built application for packaging during fluent build command",
            "default": "dist/app"
        },
        "packOutputDir": {
            "type": "string",
            "description": "Location to output the zip file during build process, to be later installed on the instance during install command",
            "default": "target"
        },
        "sourceDir": {
            "type": "string",
            "deprecated": true,
            "description": "DEPRECATED: This is no longer needed"
        },
        "ignoreTransformTableList": {
            "type": "array",
            "description": "List of tables to ignore when transforming entities to ServiceNow tables",
            "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z_\\d]+$"
            }
        },
        "excludeFilePatterns": {
            "type": "array",
            "description": "Glob patterns matched against incoming file basenames (not full paths) during transform. Files that match are discarded and not written to the metadata directory.",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "trustedModules": {
            "type": "array",
            "description": "List of npm module patterns to mark as trusted. Trusted modules will have external_source set to false. Valid patterns: fully qualified package names (e.g., 'lodash', '@servicenow/sdk') or organization prefixes with wildcard (e.g., '@servicenow/*'). Blanket wildcards like '*' are not allowed.",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "default": [],
            "examples": [
                [
                    "@servicenow/*",
                    "lodash"
                ]
            ]
        },
        "dependencies": {
            "type": "object",
            "description": "Reference dependencies on other ServiceNow application tables and entities, organized by scope",
            "properties": {
                "applications": {
                    "type": "object",
                    "deprecated": true,
                    "description": "DEPRECATED: Use flat scope structure instead. Move scopes directly under 'dependencies'.",
                    "patternProperties": {
                        "^global$|^(x|sn)_[a-z0-9_]+$": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "tables": {
                                    "type": "array",
                                    "description": "List of tables that this application depends on (example: 'cmdb_ci')",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1,
                                        "pattern": "^[a-z_][a-z0-9_]*[a-z0-9]$"
                                    }
                                }
                            }
                        }
                    },
                    "additionalProperties": false
                }
            },
            "patternProperties": {
                "^((x|sn)_[a-z0-9_]+|global)$": {
                    "type": "object",
                    "description": "Dependencies for this scope",
                    "properties": {
                        "tables": {
                            "oneOf": [
                                {
                                    "const": "*"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1,
                                        "pattern": "^[a-z_][a-z0-9_]*$"
                                    }
                                }
                            ],
                            "description": "Table definitions from sys_db_object (list of table names or '*' for all)"
                        },
                        "roles": {
                            "oneOf": [
                                {
                                    "const": "*"
                                },
                                {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "minLength": 1,
                                        "pattern": "^[a-z_][a-z0-9_.]*$"
                                    }
                                }
                            ],
                            "description": "Role definitions from sys_user_role (list of role names or '*' for all)"
                        }
                    },
                    "additionalProperties": {
                        "oneOf": [
                            {
                                "const": "*"
                            },
                            {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1,
                                    "pattern": "^[0-9a-f]{32}$"
                                }
                            }
                        ],
                        "description": "Custom table records (list of sys_ids or '*' for all)"
                    }
                }
            },
            "additionalProperties": false
        },
        "active": {
            "type": "boolean",
            "description": "Is the application active"
        },
        "hostedPlugins": {
            "type": "object",
            "description": "Map of hosted plugin folder names to their scope names",
            "patternProperties": {
                ".*": {
                    "type": "string",
                    "description": "scope",
                    "pattern": "^((x|sn)_[a-z0-9_]+|global)$"
                }
            },
            "additionalProperties": false,
            "doNotSuggest": true
        },
        "sysCode": {
            "type": "string",
            "description": "Plugin sys_code for the app",
            "doNotSuggest": true
        },
        "ideCreated": {
            "anyOf": [
                {
                    "enum": [
                        "IDE",
                        "GAC",
                        "AES",
                        "LAC",
                        "DS",
                        "CS",
                        "FORM",
                        "SNS"
                    ]
                },
                {
                    "type": "string",
                    "maxLength": 4
                }
            ],
            "description": "Key to indicate which IDE was used to create the package",
            "doNotSuggest": true
        },
        "accessControls": {
            "type": "object",
            "additionalProperties": false,
            "description": "Manage scoping restrictions and access to the application",
            "properties": {
                "scopedAdministration": {
                    "type": "boolean",
                    "description": "If true, System Admins will be prevented from accessing the application",
                    "default": false
                },
                "canEditInStudio": {
                    "type": "boolean",
                    "description": "Can the application be opened in developer studio",
                    "default": true
                },
                "runtimeAccessTracking": {
                    "type": "string",
                    "enum": [
                        "none",
                        "permissive",
                        "enforcing"
                    ],
                    "description": "Runtime access tracking for the application",
                    "default": "permissive"
                },
                "restrictTableAccess": {
                    "type": "boolean",
                    "description": "Restrict design time access to tables from outside the application",
                    "default": false
                },
                "private": {
                    "type": "boolean",
                    "description": "Mark the application as private",
                    "default": false
                },
                "trackable": {
                    "type": "boolean",
                    "description": "Mark the application as trackable",
                    "default": true
                },
                "uninstallBlocked": {
                    "type": "boolean",
                    "description": "Uninstall blocked for the application",
                    "default": false
                },
                "hideOnUI": {
                    "type": "boolean",
                    "description": "Application hidden in UI",
                    "default": false
                },
                "userRole": {
                    "type": "string",
                    "description": "Role required for end users to access the application and its tables",
                    "pattern": "^[0-9a-f]{32}$"
                }
            }
        },
        "jsLevel": {
            "type": "string",
            "enum": [
                "es_latest",
                "helsinki_es5",
                "traditional"
            ],
            "description": "JavaScript level for the application",
            "default": "es_latest"
        },
        "licensing": {
            "type": "object",
            "additionalProperties": false,
            "description": " If this application is licensable, set the subscription requirement and model.",
            "properties": {
                "licensable": {
                    "type": "boolean",
                    "description": "Mark package as licensable",
                    "default": true
                },
                "enforceLicense": {
                    "type": "string",
                    "enum": [
                        "none",
                        "log",
                        "enforce"
                    ],
                    "description": "Subscription requirement for the application",
                    "default": "log"
                },
                "licenseModel": {
                    "type": "string",
                    "enum": [
                        "none",
                        "fulfiller",
                        "producer",
                        "capacity",
                        "mixed",
                        "app_use"
                    ],
                    "description": "License model for the application",
                    "default": "none"
                },
                "licenseCategory": {
                    "type": "string",
                    "enum": [
                        "none",
                        "general",
                        "beta"
                    ],
                    "description": "License category for the application",
                    "default": "none"
                },
                "subscriptionEntitlement": {
                    "type": "string",
                    "description": "SysID of the subscription entitlement for the application",
                    "pattern": "^[0-9a-f]{32}$"
                }
            }
        },
        "menu": {
            "type": "string",
            "description": "SysID of the application's primary menu for default table modules",
            "pattern": "^[0-9a-f]{32}$"
        },
        "description": {
            "type": "string",
            "description": "Description of the application"
        },
        "logo": {
            "type": "string",
            "description": "SysID of the app logo, or a project-relative path to the app logo image file",
            "anyOf": [
                {
                    "pattern": "^[0-9a-f]{32}$"
                },
                {
                    "pattern": "^[^\\n]+\\.[A-Za-z0-9]+$"
                }
            ]
        },
        "guidedSetupGuid": {
            "type": "string",
            "description": "SysID of the Guided Setup to start when the application is upgraded",
            "pattern": "^[0-9a-f]{32}$"
        },
        "installedAsDependency": {
            "type": "boolean",
            "description": "App was installed as a dependency",
            "default": false
        },
        "scripts": {
            "type": "object",
            "description": "Define scripts that are executed with the SDK task runner. The task functions are async and are passed APIs for cross-environment compatibility. Use prebuild to run a script before the build process for custom build tasks.",
            "patternProperties": {
                ".*": {
                    "type": "string",
                    "pattern": "\\.m?js$"
                }
            }
        },
        "tableOutputFormat": {
            "type": "string",
            "enum": [
                "bootstrap",
                "component"
            ],
            "default": "bootstrap",
            "description": "Artifact type built for table definitions. Traditional bootstrap or separate component records."
        },
        "emitDictionary": {
            "type": "boolean",
            "default": true,
            "description": "Generate sys_dictionary and sys_db_object update records alongside bootstrap XML.",
            "doNotSuggest": true
        },
        "packageSourceCodeOnInstance": {
            "type": "boolean",
            "default": false,
            "description": "When true, source code can produce source code artifacts that are installed on the instance. When false (default) or omitted, no source code artifacts are built or attached."
        },
        "legacyChoices": {
            "type": "boolean",
            "default": true,
            "description": "When true (default), generates choice set XML with a sys_choice_set wrapper element (v3 destructive delete-all-then-insert behavior, supported on all platform versions). When false, generates choice set XML with a sys_choice_v2 wrapper element (v4 additive merge with removed_choices tracking, supported on Brazil+, Australia P4+, Zurich P11+). Older instances without v4 support safely skip sys_choice_v2 records."
        },
        "linter": {
            "type": "object",
            "additionalProperties": false,
            "description": "Enable/Disable internal Fluent linting behavior",
            "properties": {
                "module": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Configuration for the module linter",
                    "properties": {
                        "enabled": {
                            "type": "boolean",
                            "description": "Whether the module linter is enabled",
                            "default": true
                        }
                    }
                }
            }
        },
        "defaultLanguage": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z]{2,3}(-[a-zA-Z0-9]{2,8})*$",
            "default": "en",
            "description": "BCP 47 language tag for table/column documentation defaults. Used to resolve labels from multi-language documentation arrays (e.g., 'en', 'es', 'fr', 'en-US', 'zh-Hans')."
        },
        "tableDefaultLanguage": {
            "type": "string",
            "minLength": 2,
            "pattern": "^[a-z]{2,3}(-[a-zA-Z0-9]{2,8})*$",
            "deprecated": true,
            "description": "DEPRECATED. Use 'defaultLanguage' instead."
        },
        "packageResolverVersion": {
            "type": "string",
            "enum": [
                "1.0.0",
                "2.0.0"
            ],
            "default": "1.0.0",
            "description": "Rhino module resolver version. Must be 2.0.0+ for Global apps"
        },
        "type": {
            "type": "string",
            "enum": [
                "package",
                "configuration"
            ],
            "default": "package",
            "description": "Whether this project represents a scoped/global app package or a set of a record changes"
        },
        "installAs": {
            "type": "string",
            "enum": [
                "custom",
                "store"
            ],
            "default": "custom",
            "doNotSuggest": true,
            "description": "Application install type. 'custom' installs as a sys_app (default). 'store' installs as a sys_store_app (requires maint access). Can only be set when 'type' is 'package'."
        },
        "taxonomy": {
            "type": "object",
            "description": "Configuration for taxonomy-based file organization",
            "properties": {
                "mapping": {
                    "type": "object",
                    "description": "Maps table names to their folder path for organization. Resulting files will be placed in '{generatedDir}/{path}'",
                    "additionalProperties": {
                        "type": "string",
                        "description": "Folder path for this table (e.g. 'server-development/business-rule' or 'integration/outbound/rest-api')",
                        "pattern": "^[a-z0-9_-]+(/[a-z0-9_-]+)*$"
                    },
                    "propertyNames": {
                        "pattern": "^[a-z0-9_]+$",
                        "description": "Table names should only contain lowercase alphanumeric characters and underscores"
                    }
                },
                "fallbackFolderName": {
                    "type": "string",
                    "description": "Folder name to use when a table doesn't have a mapping (lowercase, no spaces or special chars)",
                    "pattern": "^[a-z0-9_-]+$"
                }
            }
        },
        "applicationRuntimePolicy": {
            "type": "string",
            "enum": [
                "none",
                "tracking",
                "enforcing"
            ],
            "description": "Application Runtime Policy mode. Set to 'tracking' or 'enforcing' to enable policy records. Defaults to 'none' if not specified.",
            "examples": [
                "tracking"
            ]
        },
        "networkPolicies": {
            "type": "array",
            "description": "Network access policies for the application (sys_arp_network_policy)",
            "items": {
                "type": "object",
                "required": [
                    "policyType",
                    "status"
                ],
                "additionalProperties": false,
                "properties": {
                    "$id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$",
                        "description": "Unique sys_id for the record"
                    },
                    "active": {
                        "type": "boolean",
                        "default": true,
                        "description": "Whether the policy is active"
                    },
                    "policyType": {
                        "type": "string",
                        "enum": [
                            "csp_script_src",
                            "csp_connect_src",
                            "now_inbound_scoped",
                            "now_inbound_global",
                            "now_outbound"
                        ],
                        "description": "Type of network policy"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "requested",
                            "allowed",
                            "denied"
                        ],
                        "description": "Enforcement status of the policy (required - no default)"
                    },
                    "host": {
                        "type": "string",
                        "maxLength": 253,
                        "pattern": "^[a-z][a-z0-9+.-]*://[^/\\s]+$",
                        "description": "Host address with scheme (e.g., https://api.example.com). Must include scheme (https://, wss://, etc.), hostname, and optional port. Cannot contain paths - use path field instead."
                    },
                    "scheme": {
                        "type": "string",
                        "enum": [
                            "http",
                            "https",
                            "ws",
                            "wss"
                        ],
                        "description": "Protocol scheme (required for now_inbound_global, must be empty for other types)"
                    },
                    "path": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "maxLength": 1000
                        },
                        "maxItems": 100,
                        "description": "Array of paths. Each path must start with /. Use /* suffix to allow sub-paths (e.g., /api/*). For Inbound Cross Scope Request (now_inbound_scoped), fill either Path or Resource (not both)."
                    },
                    "resource": {
                        "type": "string",
                        "maxLength": 4000,
                        "pattern": "^[^\\s,\\n\\r]+\\.[^\\s,\\n\\r]+(\\.[^\\s,\\n\\r]+)?$",
                        "description": "Resource identifier for cross-scope access (only for now_inbound_scoped). Format: 'processor.subprocessor' or 'processor.subprocessor.context'. Fill either Path or Resource (not both)."
                    },
                    "shortDescription": {
                        "type": "string",
                        "maxLength": 1024,
                        "description": "Human-readable description of the policy"
                    }
                },
                "allOf": [
                    {
                        "if": {
                            "properties": {
                                "policyType": {
                                    "enum": [
                                        "csp_script_src",
                                        "csp_connect_src",
                                        "now_outbound"
                                    ]
                                }
                            }
                        },
                        "then": {
                            "required": [
                                "host"
                            ],
                            "not": {
                                "required": [
                                    "resource"
                                ]
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "policyType": {
                                    "const": "now_inbound_global"
                                }
                            }
                        },
                        "then": {
                            "required": [
                                "scheme",
                                "path"
                            ],
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "host"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "resource"
                                        ]
                                    }
                                ]
                            }
                        }
                    },
                    {
                        "if": {
                            "properties": {
                                "policyType": {
                                    "const": "now_inbound_scoped"
                                }
                            }
                        },
                        "then": {
                            "oneOf": [
                                {
                                    "required": [
                                        "path"
                                    ],
                                    "not": {
                                        "required": [
                                            "resource"
                                        ]
                                    }
                                },
                                {
                                    "required": [
                                        "resource"
                                    ],
                                    "not": {
                                        "required": [
                                            "path"
                                        ]
                                    }
                                }
                            ],
                            "not": {
                                "anyOf": [
                                    {
                                        "required": [
                                            "host"
                                        ]
                                    },
                                    {
                                        "required": [
                                            "scheme"
                                        ]
                                    }
                                ]
                            }
                        }
                    }
                ]
            },
            "examples": [
                [
                    {
                        "policyType": "now_outbound",
                        "host": "https://api.example.com",
                        "status": "requested"
                    }
                ]
            ]
        },
        "wildcardPolicy": {
            "type": "object",
            "description": "Wildcard/exemption policy for the application (sys_arp_segment_policy). Only one per scope.",
            "additionalProperties": false,
            "properties": {
                "$id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$",
                    "description": "Unique sys_id for the record"
                },
                "active": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether the policy is active"
                },
                "shortDescription": {
                    "type": "string",
                    "maxLength": 1024,
                    "description": "Human-readable description of the policy"
                },
                "record": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable Record pillar access"
                },
                "network": {
                    "type": "object",
                    "description": "Network pillar configuration",
                    "additionalProperties": false,
                    "properties": {
                        "active": {
                            "type": "boolean",
                            "default": false,
                            "description": "Enable network pillar"
