{
  "name": "@servicenow/sdk-core",
  "version": "4.13.0",
  "description": "ServiceNow SDK - Core",
  "license": "MIT",
  "types": "dist/global/index.d.ts",
  "files": [
    "dist",
    "src",
    "now.config.json"
  ],
  "exports": {
    "./global": "./dist/global/index.d.ts",
    "./external/core": "./src/external/core.ts",
    "./external/automation": "./src/external/automation.ts",
    "./*": "./src/*/index.ts",
    "./runtime/*": "./dist/*/index.js"
  },
  "devDependencies": {
    "@types/node": "20.17.6"
  },
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=10.8.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist",
    "watch": "tsc -b -w",
    "test": "export NODE_OPTIONS=\"--max-old-space-size=8192 --experimental-vm-modules\" && jest --colors --no-cache --logHeapUsage"
  }
}